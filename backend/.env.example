# DeepSeek API Key - 请填写你的API密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# JWT Configuration
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# Database Configuration (optional - 默认使用SQLite)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=ai_security_range

# Log Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/system.log

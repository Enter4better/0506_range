# ============================================
# AI攻防靶场管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填入真实值
# ============================================

# 数据库配置
DB_PATH=backend/data/ai_security_range.db
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=ai_security_range

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=logs/system.log

# Docker配置
DOCKER_BASE_IMAGE=nginx
DOCKER_PREFIX=cyber_range_

# AI配置（DeepSeek）
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=your_deepseek_api_key_here
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7

# 异步队列配置
ASYNC_QUEUE_SIZE=100
ASYNC_WORKERS=4
ASYNC_TIMEOUT=30

# Watchdog配置
WATCHDOG_PATH_1=/var/log/docker
WATCHDOG_PATH_2=logs

# 安全配置
# 请使用 python -c "import secrets; print(secrets.token_hex(32))" 生成随机密钥
SECRET_KEY=your-secret-key-here
TOKEN_EXPIRE=3600
PASSWORD_HASH=pbkdf2:sha256:260000